{
  "name": "appli-trading",
  "version": "1.0.0",
  "private": true,
  "description": "Tableau de bord marchés en direct : superposition d'actifs, outils graphiques automatiques (Fibonacci, tendances, S/R), alertes et analyse de marché.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:demo": "concurrently -k -n api,web -c cyan,magenta \"cross-env DEMO=1 tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "express": "4.21.2",
    "lightweight-charts": "5.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "cross-env": "7.0.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
